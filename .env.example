# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
LOG_LEVEL=info
PORT=3000
# Local development: keep 127.0.0.1. Production behind an HTTPS proxy: 0.0.0.0 plus MCP_ALLOWED_HOSTS
# and an access restriction (MCP_ALLOWED_CLIENT_IPS and/or MCP_AUTH_TOKEN).
HOST=127.0.0.1

# Your public Chess.com username (not your Claude identity). No password is ever needed.
CHESSCOM_USERNAME=your_chesscom_username
CHESSCOM_USER_AGENT=ChessIntelligenceMCP/1.0 (contact: you@example.com)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess_intelligence
# Used only by `npm test` for database integration tests. Created by docker-compose on first start.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chess_intelligence_test

# --- /mcp access control ---------------------------------------------------------------------
# When NODE_ENV=production or HOST is not loopback, at least one of MCP_ALLOWED_CLIENT_IPS and
# MCP_AUTH_TOKEN is required (or MCP_ALLOW_UNAUTHENTICATED=true to knowingly run an open server).
#
# Client IPs admitted without a token (comma-separated CIDR). For Claude.ai, Anthropic's outbound
# ranges: 160.79.104.0/21,153.61.208.0/20 (https://platform.claude.com/docs/en/api/ip-addresses)
MCP_ALLOWED_CLIENT_IPS=
# Bearer token accepted from any IP (Claude Code, MCP Inspector). Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=
MCP_ALLOW_UNAUTHENTICATED=false
# Comma-separated public hostnames accepted in the Host header (DNS rebinding protection).
# Mandatory when HOST is not loopback, e.g. chess-mcp.example.com
MCP_ALLOWED_HOSTS=
# Reverse-proxy hops in front of the app (1 behind a single platform load balancer or Caddy/nginx).
TRUST_PROXY=0
# Requests per minute per client IP on /mcp; 0 disables.
MCP_RATE_LIMIT_PER_MINUTE=120
# Serve any Chess.com username instead of only CHESSCOM_USERNAME. Refused on an open public server.
MCP_ALLOW_ANY_USERNAME=false

REQUEST_TIMEOUT_MS=10000
MAX_SYNC_MONTHS_PER_CALL=12
DEFAULT_GAME_LIMIT=20
# Minimum seconds between the end of one sync and the next for the same player; 0 disables.
SYNC_COOLDOWN_SECONDS=30
