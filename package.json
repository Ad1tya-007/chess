{
  "name": "chess-intelligence-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only Chess.com data intelligence MCP server for Claude (remote MCP over Streamable HTTP).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:prod": "node --env-file-if-exists=.env dist/db/migrate.js && node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:migrate:prod": "node --env-file-if-exists=.env dist/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "inspector": "npx @modelcontextprotocol/inspector",
    "smoke:chesscom": "tsx --env-file-if-exists=.env scripts/chesscom-smoke.ts",
    "sync": "tsx --env-file-if-exists=.env scripts/sync.ts",
    "check:remote": "tsx scripts/check-remote.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "chess.js": "1.4.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
